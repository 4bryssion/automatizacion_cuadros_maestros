# Material de marca: se publican el logotipo de Areandina y Brown Std (la institución tiene permiso, 25-nov-2026).
# El logo del CNA no se sube; el icono se crea al empaquetar.
assets/*
!assets/marca/
assets/marca/*
!assets/marca/logotipo_verde.png
!assets/marca/fuentes/
!assets/marca/fuentes/BrownStd-*.ttf
*.pdf
*.pptx

# Python / empaquetado
__pycache__/
*.pyc
build/
dist/
*.spec
.pytest_cache/
*.egg-info/

# Configuración local que crea el programa al ejecutarse desde el código fuente
/Configuración/

# Copias anonimizadas de los Excel reales: solo en el equipo local, nunca en el repositorio público
tests/datos/reales_anonimizados/*
!tests/datos/reales_anonimizados/LEEME.md
